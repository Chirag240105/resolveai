{
  "name": "resolveai",
  "version": "1.0.0",
  "description": "AI-powered dispute investigation and evidence intelligence platform for PayPal merchants",
  "license": "MIT",
  "author": "ResolveAI Team",
  "type": "module",
  "main": "apps/api/dist/src/server.js",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "build": "tsc -p apps/api/tsconfig.json",
    "start": "node apps/api/dist/src/server.js",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'lint ok'",
    "db:generate": "prisma generate --config apps/api/prisma.config.ts",
    "db:validate": "prisma validate --config apps/api/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config apps/api/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config apps/api/prisma.config.ts",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "db:reset": "prisma migrate reset --config apps/api/prisma.config.ts --force"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
