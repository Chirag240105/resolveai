# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=resolveai
DATABASE_URL=postgresql://resolveai:replace_with_a_local_password@localhost:5432/resolveai?schema=public

# Authentication (generate a random value of at least 32 characters)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=12h

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# PayPal Sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Local document storage
UPLOAD_DIR=./uploads

# Seeded demo mode (set to true to use pre-seeded disputes for demo)
DEMO_MODE=false

# Optional local development seed
# SEED_USER_EMAIL=merchant@resolveai.test
# SEED_USER_PASSWORD=replace_with_a_long_local_password
# SEED_BUSINESS_NAME=Demo Electronics Store
